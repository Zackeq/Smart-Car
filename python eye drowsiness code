import cv2
import mediapipe as mp
import serial
import time
import requests
import pyttsx3
import threading


# ==================== TELEGRAM SETTINGS ====================

BOT_TOKEN = "YOUR_BOT_TOKEN"
CHAT_ID = "YOUR_CHAT_ID"


# ==================== DROWSINESS SETTINGS ====================

EAR_THRESHOLD = 0.26

# Number of frames before slowing down
SLOW_FRAME_TRIGGER = 5

# Number of frames before stopping the car
STOP_FRAME_TRIGGER = 15

frame_counter = 0

telegram_alert_sent = False
voice_alert_sent = False

# Keeps the program from sending the same command repeatedly
last_sent_command = ""


# ==================== TEXT TO SPEECH ====================

tts_engine = pyttsx3.init()

tts_engine.setProperty("rate", 165)
tts_engine.setProperty("volume", 1.0)


def speak_alert(message):
    """Play a voice warning without stopping the camera."""

    def play_voice():
        tts_engine.say(message)
        tts_engine.runAndWait()

    threading.Thread(
        target=play_voice,
        daemon=True
    ).start()


# ==================== FACE & EYE DETECTION ====================

mp_face_mesh = mp.solutions.face_mesh

face_mesh = mp_face_mesh.FaceMesh(
    max_num_faces=1,
    refine_landmarks=True,
    min_detection_confidence=0.6,
    min_tracking_confidence=0.6
)


# ==================== CAMERA ====================

cap = cv2.VideoCapture(1)

if not cap.isOpened():
    print("Camera could not be opened.")
    exit()


# ==================== ARDUINO CONNECTION ====================

SERIAL_PORT = "COM6"
BAUD_RATE = 9600

try:
    arduino = serial.Serial(
        SERIAL_PORT,
        BAUD_RATE,
        timeout=1,
        write_timeout=1
    )

    # Give the Arduino time to start
    time.sleep(2)

    print(f"Arduino connected on {SERIAL_PORT}.")

except Exception as error:
    print("Arduino could not be connected.")
    print("Running without the car.")
    print(error)

    arduino = None


# ==================== CALCULATE DISTANCE ====================

def calculate_distance(point1, point2):
    return (
        (point1[0] - point2[0]) ** 2
        + (point1[1] - point2[1]) ** 2
    ) ** 0.5


# ==================== CALCULATE EYE RATIO ====================

def get_eye_ratio(landmarks, width, height, eye_indices):
    points = []

    for index in eye_indices:
        landmark = landmarks[index]

        x = int(landmark.x * width)
        y = int(landmark.y * height)

        points.append((x, y))

    vertical_distance = calculate_distance(
        points[0],
        points[1]
    )

    horizontal_distance = calculate_distance(
        points[2],
        points[3]
    )

    return vertical_distance / max(
        0.001,
        horizontal_distance
    )


# ==================== SEND TELEGRAM ALERT ====================

def send_telegram_alert():

    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"

    message = (
        "⚠️ EMERGENCY VEHICLE ALERT ⚠️\n\n"
        "Driver drowsiness has been detected.\n"
        "The vehicle has automatically stopped.\n"
        "Please check on the driver."
    )

    data = {
        "chat_id": CHAT_ID,
        "text": message
    }

    try:
        response = requests.post(
            url,
            json=data,
            timeout=5
        )

        if response.status_code == 200:
            print("Telegram emergency alert sent.")

        else:
            print(
                "Telegram alert failed.",
                response.status_code
            )

    except Exception as error:
        print("Could not send Telegram alert.")
        print(error)


# ==================== START SYSTEM ====================

print()
print("Driver monitoring system started.")
print("Press 'q' to close the camera window.")


# ==================== MAIN LOOP ====================

try:

    while True:

        # Get a frame from the camera
        success, frame = cap.read()

        if not success:
            print("Could not read camera frame.")
            break


        # Flip the camera so it behaves like a mirror
        frame = cv2.flip(frame, 1)

        height, width, _ = frame.shape


        # Convert the image for MediaPipe
        rgb_frame = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2RGB
        )

        results = face_mesh.process(rgb_frame)


        # Default values
        current_ear = 0.0

        status_text = "STATUS: AWAKE"

        status_color = (0, 255, 0)

        current_command = "NORMAL"


        # ==================== FACE DETECTED ====================

        if results.multi_face_landmarks:

            landmarks = results.multi_face_landmarks[
                0
            ].landmark


            # MediaPipe eye landmark points
            left_eye = [159, 145, 33, 133]
            right_eye = [386, 374, 362, 263]


            # Calculate eye ratios
            left_ear = get_eye_ratio(
                landmarks,
                width,
                height,
                left_eye
            )

            right_ear = get_eye_ratio(
                landmarks,
                width,
                height,
                right_eye
            )


            # Average both eyes
            current_ear = (
                left_ear + right_ear
            ) / 2.0


            # Check if eyes are closed
            if current_ear < EAR_THRESHOLD:
                frame_counter += 1
            else:
                frame_counter = 0


        # ==================== DROWSINESS CHECK ====================

        # Serious drowsiness
        if frame_counter >= STOP_FRAME_TRIGGER:

            status_text = "CRITICAL: DROWSINESS DETECTED"
            status_color = (0, 0, 255)

            current_command = "STOP"


            # Send Telegram alert only once
            if not telegram_alert_sent:

                send_telegram_alert()

                telegram_alert_sent = True


            # Play voice warning only once
            if not voice_alert_sent:

                speak_alert(
                    "Wake up! Wake up! You are falling asleep!"
                )

                voice_alert_sent = True


        # Early warning
        elif frame_counter >= SLOW_FRAME_TRIGGER:

            status_text = "WARNING: DROWSINESS DETECTED"
            status_color = (0, 165, 255)

            current_command = "SLOW"

            telegram_alert_sent = False
            voice_alert_sent = False


        # Driver is awake
        else:

            status_text = "STATUS: AWAKE"

            current_command = "NORMAL"

            telegram_alert_sent = False
            voice_alert_sent = False


        # ==================== SEND COMMAND TO ARDUINO ====================

        # Only send the command when it changes
        if (
            arduino
            and current_command != last_sent_command
        ):

            try:

                command = (
                    f"{current_command}\n"
                ).encode("utf-8")

                arduino.write(command)

                arduino.flush()

                print(
                    f"Command sent to car: "
                    f"{current_command}"
                )

                last_sent_command = current_command

            except Exception as error:

                print(
                    "Could not send command to Arduino."
                )

                print(error)


        # ==================== DISPLAY INFORMATION ====================

        cv2.putText(
            frame,
            f"EAR: {current_ear:.2f}",
            (40, 50),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            (255, 255, 255),
            2
        )


        cv2.putText(
            frame,
            status_text,
            (40, 95),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.8,
            status_color,
            2
        )


        cv2.putText(
            frame,
            f"Closed Frames: {frame_counter}",
            (40, 135),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.6,
            (200, 200, 200),
            2
        )


        # Show camera window
        cv2.imshow(
            "Driver Monitoring System",
            frame
        )


        # Press Q to exit
        if cv2.waitKey(1) & 0xFF == ord("q"):
            break


# ==================== CLOSE PROGRAM ====================

except KeyboardInterrupt:

    print("Program stopped.")


finally:

    cap.release()

    cv2.destroyAllWindows()

    if arduino:
        arduino.close()

    print("System closed.")
